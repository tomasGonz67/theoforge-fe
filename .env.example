# API Configuration - NOTE: Vite requires VITE_ prefix for all env variables
VITE_OPENAI_API_KEY=your_api_key_here

# Authentication
VITE_AUTH_STORAGE_KEY=theoforge_auth_token

# AI Assistant Configuration
VITE_AI_HISTORY_KEY=theoforge_ai_chat_history
VITE_AI_MAX_HISTORY=50

# Environment
NODE_ENV=development